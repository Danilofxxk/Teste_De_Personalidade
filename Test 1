<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>My first GitHub site</title>
  <style>
    /* Colors live in variables so light and dark themes only change these values */
    :root {
      --bg: #eef2f7;
      --ink: #14213d;
      --muted: #55657d;
      --accent: #2b59c3;
      --card: #ffffff;
      --line: #d3dbe6;
    }
    @media (prefers-color-scheme: dark) {
      :root:not([data-theme="light"]) {
        --bg: #111a2b; --ink: #e8eefb; --muted: #9db0cf;
        --accent: #7ea3f5; --card: #18243a; --line: #2a3a58;
      }
    }
    :root[data-theme="dark"] {
      --bg: #111a2b; --ink: #e8eefb; --muted: #9db0cf;
      --accent: #7ea3f5; --card: #18243a; --line: #2a3a58;
    }
 
    * { box-sizing: border-box; }
    body {
      margin: 0;
      background: var(--bg);
      color: var(--ink);
      font: 1.0625rem/1.6 system-ui, -apple-system, "Segoe UI", sans-serif;
    }
    .wrap { max-width: 42rem; margin: 0 auto; padding: 2rem 1.25rem 4rem; }
 
    header { display: flex; justify-content: space-between; align-items: center; }
    nav a { margin-right: 1rem; color: var(--ink); text-decoration: none; font-weight: 600; }
    nav a:hover { color: var(--accent); }
    a:focus-visible, button:focus-visible { outline: 3px solid var(--accent); outline-offset: 2px; }
 
    button {
      font: inherit; cursor: pointer;
      color: var(--ink); background: var(--card);
      border: 1px solid var(--line); border-radius: 6px; padding: .4rem .8rem;
    }
 
    h1 { font-size: clamp(2.2rem, 7vw, 3.4rem); line-height: 1.1; margin: 4rem 0 1rem; }
    h2 { margin: 3rem 0 1rem; font-size: 1.4rem; }
    p { max-width: 38rem; }
    .muted { color: var(--muted); }
 
    .projects { list-style: none; padding: 0; margin: 0; }
    .projects li {
      padding: 1rem 0; border-top: 1px solid var(--line);
    }
    .projects li:last-child { border-bottom: 1px solid var(--line); }
    .projects a { color: var(--accent); font-weight: 600; }
 
    footer { margin-top: 4rem; color: var(--muted); font-size: .9rem; }
  </style>
</head>
<body>
  <div class="wrap">
    <header>
      <nav>
        <a href="#about">About</a>
        <a href="#projects">Projects</a>
        <a href="#contact">Contact</a>
      </nav>
      <button id="theme-toggle" type="button">Dark mode</button>
    </header>
 
    <main>
      <h1>Hi, I’m building my first website.</h1>
      <p class="muted">This page is hosted for free on GitHub Pages. Edit this file, commit it, and the site updates in about a minute.</p>
 
      <h2 id="about">About</h2>
      <p>Write a few sentences about yourself or your project here. Keep it short and say what visitors can do on the page.</p>
 
      <h2 id="projects">Projects</h2>
      <ul class="projects">
        <li><a href="https://github.com/" target="_blank" rel="noopener">Project one</a><br><span class="muted">One line about what it does.</span></li>
        <li><a href="https://github.com/" target="_blank" rel="noopener">Project two</a><br><span class="muted">One line about what it does.</span></li>
      </ul>
 
      <h2 id="contact">Contact</h2>
      <p>Email me at <a href="mailto:you@example.com">you@example.com</a>.</p>
    </main>
 
    <footer>
      <p>Visitors on this page so far in this browser: <strong id="visits">1</strong></p>
    </footer>
  </div>
 
  <script>
    // 1. Theme toggle: switches between light and dark and remembers the choice
    const root = document.documentElement;
    const toggle = document.getElementById("theme-toggle");
 
    function applyTheme(theme) {
      root.setAttribute("data-theme", theme);
      toggle.textContent = theme === "dark" ? "Light mode" : "Dark mode";
    }
 
    let saved = null;
    try { saved = localStorage.getItem("theme"); } catch (e) { /* storage can be blocked */ }
    const prefersDark = window.matchMedia("(prefers-color-scheme: dark)").matches;
    applyTheme(saved || (prefersDark ? "dark" : "light"));
 
    toggle.addEventListener("click", () => {
      const next = root.getAttribute("data-theme") === "dark" ? "light" : "dark";
      applyTheme(next);
      try { localStorage.setItem("theme", next); } catch (e) {}
    });
 
    // 2. Visit counter: counts how many times THIS browser opened the page
    let visits = 1;
    try {
      visits = Number(localStorage.getItem("visits") || 0) + 1;
      localStorage.setItem("visits", visits);
    } catch (e) {}
    document.getElementById("visits").textContent = visits;
  </script>
</body>
</html>
